<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/shape_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_perm_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_perm_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/tv_perm_name"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_perm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:stepSize="1"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="2"
        app:labelBehavior="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_perm_tag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lb_allow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="允许"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/slider_perm"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lb_deny"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拒绝"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintTop_toTopOf="@id/lb_allow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5" />

    <TextView
        android:id="@+id/lb_forever"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="不再询问"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintTop_toTopOf="@id/lb_allow"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
