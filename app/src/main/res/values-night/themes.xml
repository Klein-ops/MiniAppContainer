<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 全局主题：Material 3（DayNight 自动切换浅色/暗色） -->
    <style name="Theme.MiniApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 color role：严格配对（primary↔onPrimary、container↔onContainer，不跨配对） -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md3_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md3_onSecondaryContainer</item>
        <!-- 强调色（第三种彩色，算法同源、对比度有保证） -->
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorOnTertiary">@color/md3_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md3_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md3_onTertiaryContainer</item>
        <!-- error 家族 -->
        <item name="colorError">@color/md3_error</item>
        <item name="colorOnError">@color/md3_onError</item>
        <item name="colorErrorContainer">@color/md3_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md3_onErrorContainer</item>
        <!-- surface / 中性面 tonal 层次 -->
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_onSurface</item>
        <item name="colorSurfaceVariant">@color/md3_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md3_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/md3_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md3_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md3_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md3_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md3_surfaceContainerHighest</item>
        <item name="colorSurfaceDim">@color/md3_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md3_surfaceBright</item>
        <!-- outline / inverse / scrim -->
        <item name="colorOutline">@color/md3_outline</item>
        <item name="colorOutlineVariant">@color/md3_outlineVariant</item>
        <item name="colorOnSurfaceInverse">@color/md3_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md3_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md3_inversePrimary</item>
        <item name="android:windowBackground">@color/bg_window</item>
        <!-- 状态栏：浅色（跟随 Toolbar surfaceContainer）+ 深色图标（MD3 现代一体化） -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/md3_surfaceContainer</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- 页面切换动画 -->
        <item name="android:windowAnimationStyle">@style/Animation.MiniApp.Activity</item>
        <!-- 所有 AlertDialog 统一圆角 -->
        <item name="android:alertDialogTheme">@style/ThemeOverlay.MiniApp.RoundedDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MiniApp.RoundedDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MiniApp.RoundedDialog</item>
    </style>

    <!-- 圆角对话框主题覆盖：Material3 官方 overlay -->
    <style name="ThemeOverlay.MiniApp.RoundedDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MiniApp.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MiniApp.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MiniApp.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MiniApp.DialogButton</item>
    </style>

    <!-- 自行控制窗口尺寸的对话框主题（圆角由内容视图自身背景提供，
         故窗口背景透明；避免系统 inset 干扰高度计算） -->
    <style name="Theme.MiniApp.FloatingDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
    </style>

    <!-- 对话框圆角形状外观：28dp（MD3 extra-large 规范） -->
    <style name="ShapeAppearance.MiniApp.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.MiniApp.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/md3_primary</item>
    </style>
    <!-- 开关（夜间）：开启态 thumb/track 用亮橙强调色（与 CTA 一致，昼夜统一橙；不覆盖 colorControlNormal 保持关闭态原样） -->
    <style name="ThemeOverlay.MiniApp.Switch" parent="">
        <item name="colorControlActivated">@color/brand_accent</item>
    </style>

    <!-- 设置页/应用设置页统一卡片行：Filled 无描边（surfaceContainerHighest 填充，MD3 Filled 变体）、圆角、可点击涟漪 -->
    <style name="Widget.MiniApp.SettingCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md3_surfaceContainerHighest</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- 页面进入/退出动画 -->
    <style name="Animation.MiniApp.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>