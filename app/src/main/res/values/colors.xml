<resources>
    <!-- ============ 配色方案：纯绿主色 + 烧橙强调色（简约沉稳，无蓝绿/荧光） ============
         primary/中性面 来自 SchemeVibrant(seed #2E7D32) 官方算法（material-color-utilities）
         tertiary（强调色）手动指定烧橙 #C2410C（青橙互补中的暖色领地主色，稳重不跳） -->
    <!-- 品牌语义色（名字保持与代码引用兼容） -->
    <color name="brand_primary">#006E1B</color>            <!-- Vibrant primary：深纯绿（不偏蓝） -->
    <color name="brand_primary_dark">#005312</color>       <!-- Vibrant onPrimaryContainer：更深绿 -->
    <color name="brand_accent">#C2410C</color>             <!-- 强调色：烧橙（手动指定） -->
    <color name="danger">#BA1A1A</color>                   <!-- Vibrant error -->
    <color name="ok">#16A34A</color>                       <!-- 语义绿 -->
    <!-- 品牌色 - on/container 配对 -->
    <color name="brand_on_primary">#FFFFFF</color>
    <color name="brand_primary_container">#A8E6B0</color>
    <color name="brand_on_primary_container">#005312</color>
    <color name="brand_on_secondary">#FFFFFF</color>       <!-- Vibrant onSecondary -->
