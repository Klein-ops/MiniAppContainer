    <color name="bg_window">#F3FCEC</color>                <!-- Vibrant surface：页面底色 -->
    <color name="bg_card">#EDF6E7</color>                  <!-- surfaceContainerLow：卡片/浮层 -->
    <color name="bg_card_raised">#E2EBDB</color>           <!-- surfaceContainerHigh -->
    <color name="text_primary">#161E14</color>             <!-- Vibrant onSurface -->
    <color name="text_secondary">#3F4A3C</color>           <!-- Vibrant onSurfaceVariant -->
    <color name="divider">#BECAB8</color>                  <!-- Vibrant outlineVariant -->
