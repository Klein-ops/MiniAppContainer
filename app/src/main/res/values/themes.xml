<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MiniApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_primary_dark</item>
        <!-- 页面切换动画 -->
        <item name="android:windowAnimationStyle">@style/Animation.MiniApp.Activity</item>
        <!-- 所有 AlertDialog 统一圆角（24dp 大弧度，显式指定避免 Material 默认小圆角） -->
        <item name="android:alertDialogTheme">@style/ThemeOverlay.MiniApp.RoundedDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MiniApp.RoundedDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MiniApp.RoundedDialog</item>
</style>

<!-- 圆角对话框主题覆盖：显式指定 24dp 大圆角 + Material 配色。
     父级用官方推荐的 ThemeOverlay.MaterialComponents.MaterialAlertDialog，
     否则 shapeAppearanceOverlay 可能不生效（表现为直角）。 -->

<style name="ThemeOverlay.MiniApp.RoundedDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MiniApp.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MiniApp.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MiniApp.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MiniApp.DialogButton</item>
</style>

<!-- 对话框圆角形状外观：24dp 大弧度 -->
<style name="ShapeAppearance.MiniApp.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
</style>

    <!-- 设置页/应用设置页统一卡片行：圆角、描边、可点击涟漪 -->
    <style name="Widget.MiniApp.SettingCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.MiniApp.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- 页面进入/退出动画 -->
    <style name="Animation.MiniApp.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>
